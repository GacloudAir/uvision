  53          //-----------------------------------------------------------------------------
  54          // SYSCLK_Init 系统时钟初始化
C51 COMPILER V9.60.7.0   LED                                                               10/09/2026 16:25:52 PAGE 2   

  55          void SYSCLK_Init (void)
  56          {
  57   1          OSCICN = 0x80;          // 内部振荡器 24.5MHz / 8
  58   1          RSTSRC = 0x04;          // 使能时钟丢失检测器
  59   1      }
  60          
  61          //-----------------------------------------------------------------------------
  62          // PORT_Init IO 端口初始化
  63          void PORT_Init (void)
  64          {
  65   1          XBR0 = 0x00;            // 未选择任何数字外设
  66   1          XBR1 = 0x40;            // 使能交叉开关和弱上拉
  67   1          P1MDOUT |= 0xE0;        // P1.5、P1.6、P1.7 设为推挽输出
  68   1      }
  69          
  70          //-----------------------------------------------------------------------------
  71          // Timer2_Init 定时器 2 初始化
  72          // counts: 重载计数值，决定中断周期
  73          void Timer2_Init (int counts)
  74          {
  75   1          TMR2CN  = 0x00;         // 停止 Timer2，16 位自动重载
  76   1          CKCON  &= ~0x60;        // Timer2 时钟源 = SYSCLK / 12
  77   1          TMR2RL  = -counts;      // 重载值
  78   1          TMR2    = 0xffff;       // 立即重载
  79   1          ET2     = 1;            // 允许 Timer2 中断
  80   1          TR2     = 1;            // 启动 Timer2
  81   1      }
  82          
  83          //-----------------------------------------------------------------------------
  84          // Timer2_ISR 定时器 2 中断服务程序
  85          void Timer2_ISR (void) interrupt 5
  86          {
  87   1          static uchar scan_idx = 0;      // 当前扫描位 0~3
  88   1          static unsigned int ms_count = 0;
  89   1      
  90   1          TF2H = 0;                       // 清中断标志
  91   1      
  92   1          // 动态扫描一位
  93   1          switch (scan_idx) {
  94   2              case 0:
  95   2                  LED_OUT(LED_0F[LED[3]]); // 段码
  96   2                  LED_OUT(0xfe);           // 位码，第 1 位
  97   2                  break;
  98   2              case 1:
  99   2                  LED_OUT(LED_0F[LED[2]]);
 100   2                  LED_OUT(0xfd);           // 第 2 位
 101   2                  break;
 102   2              case 2:
 103   2                  LED_OUT(LED_0F[LED[1]]);
 104   2                  LED_OUT(0xfb);           // 第 3 位
 105   2                  break;
 106   2              case 3:
 107   2                  LED_OUT(LED_0F[LED[0]]);
 108   2                  LED_OUT(0xf7);           // 第 4 位
 109   2                  break;
 110   2          }
 111   1          LED_LATCH = 0;                  // 锁存数据
 112   1          LED_LATCH = 1;
 113   1      
 114   1          scan_idx++;
 115   1          if (scan_idx >= 4) scan_idx = 0;
 116   1      
C51 COMPILER V9.60.7.0   LED                                                               10/09/2026 16:25:52 PAGE 3   

 117   1          // 秒计时
 118   1          ms_count++;
 119   1          if (ms_count >= 1000) {         // 约 1 秒
 120   2              ms_count = 0;
 121   2              seconds++;
 122   2              if (seconds > 9999) seconds = 0;
 123   2      
 124   2              // 更新显示缓存
 125   2              LED[3] = seconds % 10;              // 个位
 126   2              LED[2] = (seconds / 10) % 10;       // 十位
 127   2              LED[1] = (seconds / 100) % 10;      // 百位
 128   2              LED[0] = (seconds / 1000) % 10;     // 千位
 129   2          }
 130   1      }
 131          
 132          //-----------------------------------------------------------------------------
 133          // LED 单字节串行移位函数
 134          void LED_OUT(uchar X)
 135          {
 136   1          uchar i;
 137   1          for (i = 8; i >= 1; i--) {
 138   2              if (X & 0x80) LED_DOUT = 1;
 139   2              else          LED_DOUT = 0;
 140   2              X <<= 1;
 141   2              LED_CLK = 0;
 142   2              LED_CLK = 1;
 143   2          }
 144   1      }
