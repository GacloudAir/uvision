  21          // 全局常量
  22          #define SYSCLK 24500000
  23          
  24          sbit LED_DOUT  = P1^6;      // 串行数据输入
  25          sbit LED_CLK   = P1^5;      // 时钟脉冲信号——上升沿有效
  26          sbit LED_LATCH = P1^7;      // 打入信号——上升沿有效
