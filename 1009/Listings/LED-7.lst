  60          // ===== 端口初始化 =====
  61          void Port_Init(void) {
  62   1          XBR0 = 0x00;
  63   1          XBR1 = 0x40;               // 使能交叉开关
  64   1      
  65   1          // P1.4 (蜂鸣器), P1.5~P1.7 (595) 推挽输出
  66   1          P1MDOUT |= 0xF0;           // 1111 0000
  67   1          P1SKIP  |= 0xF0;           // 交叉开关跳过这些引脚
  68   1      
  69   1          BEEP = 1;                  // 初始关闭蜂鸣器（PNP：高电平截止）
  70   1          HC595_CLK   = 0;
  71   1          HC595_DATA  = 0;
  72   1          HC595_LATCH = 0;
  73   1      }
  74          
  75          // ===== Timer0 初始化（1ms 定时）=====
  76          // SYSCLK = 24500000 / 8 = 3.0625 MHz
  77          // Timer0 时钟源 = SYSCLK / 12 = 255208 Hz
  78          // 1ms 需要 255 个计数
  79          void Timer0_Init(void) {
  80   1          CKCON &= ~0x08;            // Timer0 时钟源 = SYSCLK / 12
  81   1          TMOD  = 0x01;              // Timer0 方式1：16 位定时器
  82   1          TH0 = (65536 - 255) / 256; // 高字节
  83   1          TL0 = (65536 - 255) % 256; // 低字节
  84   1          TR0 = 1;                   // 启动 Timer0
  85   1      }
  86          
  87          // ===== 简单延时（备用）=====
  88          void Delay_ms(unsigned int ms) {
  89   1          unsigned int i, j;
  90   1          for(i = 0; i < ms; i++)
  91   1              for(j = 0; j < 250; j++);
  92   1      }
  93          
  94          // ===== 向 74HC595 发送 16 位数据 =====
  95          void HC595_SendWord(unsigned char dig, unsigned char seg) {
  96   1          unsigned int data16 = ((unsigned int)dig << 8) | seg;
  97   1          unsigned char i;
  98   1      
  99   1          HC595_LATCH = 0;
 100   1          for(i = 0; i < 16; i++) {
 101   2              HC595_CLK = 0;
 102   2              if(data16 & 0x8000) {
 103   3                  HC595_DATA = 1;
 104   3              } else {
 105   3                  HC595_DATA = 0;
 106   3              }
 107   2              HC595_CLK = 1;
 108   2              data16 <<= 1;
 109   2          }
 110   1          HC595_LATCH = 1;
 111   1          HC595_LATCH = 0;
 112   1      }
